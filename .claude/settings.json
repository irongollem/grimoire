{
  "permissions": {
    "allow": [
      "mcp__github__get_issue",
      "mcp__github__list_issues",
      "mcp__context7__query-docs",
      "mcp__context7__resolve-library-id",
      "mcp__supabase__list_migrations",
      "mcp__puppeteer__puppeteer_navigate",
      "mcp__puppeteer__puppeteer_screenshot",
      "Bash(magick *)",
      "Bash(mkdir *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm run build 2>&1 | grep -E \"error TS|✓ built\"",
            "timeout": 60,
            "statusMessage": "Checking TypeScript…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | grep -q 'supabase/migrations/.*\\.sql' && echo '{\"systemMessage\":\"Migration written — check the corresponding .types.ts and any buildPayload() functions for the altered table.\"}' || true"
          }
        ]
      }
    ]
  }
}
