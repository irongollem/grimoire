{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | grep -q 'supabase/migrations/.*\\.sql' && echo '{\"systemMessage\":\"Migration written — check the corresponding .types.ts and any buildPayload() functions for the altered table.\"}' || true"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/jeffrey/Repositories/DnD helper/.codex/hooks/convention-guard.sh'",
            "timeout": 10,
            "statusMessage": "Checking conventions…"
          },
          {
            "type": "command",
            "command": "'/Users/jeffrey/Repositories/DnD helper/.codex/hooks/lint-edited-file.sh'",
            "timeout": 30,
            "statusMessage": "Linting…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/jeffrey/Repositories/DnD helper/.codex/hooks/session-start.sh'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm run build 2>&1 | grep -E \"error TS|✓ built\"",
            "timeout": 60,
            "statusMessage": "Checking TypeScript…"
          }
        ]
      }
    ]
  }
}
