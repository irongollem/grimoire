VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Asset CDN origin (#577). Leave unset to serve every bucket straight from
# Supabase Storage — that is the safe default and the current production state.
# When set, CDN-enabled buckets (see `cdn` in src/lib/storage.ts) resolve to
# `<this>/<bucket>/<path>`. Set the same value as the ASSET_CDN_URL Supabase
# secret, or Edge Functions will reject the URLs their own SSRF guard sees.
# VITE_ASSET_CDN_URL=https://cdn.dungeongrimoire.com

# Stripe — these go to Supabase secrets, NOT Vercel (never prefix with VITE_)
# .env.local is only used to run scripts/stripe-setup.mjs locally.
# Production: supabase secrets set STRIPE_SECRET_KEY=sk_live_...
STRIPE_SECRET_KEY=sk_test_...
# Set after running: npm run stripe:setup
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
