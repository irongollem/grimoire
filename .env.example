VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe — these go to Supabase secrets, NOT Vercel (never prefix with VITE_)
# .env.local is only used to run scripts/stripe-setup.mjs locally.
# Production: supabase secrets set STRIPE_SECRET_KEY=sk_live_...
STRIPE_SECRET_KEY=sk_test_...
# Set after running: npm run stripe:setup
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
