# Stripe test-mode environment — copy to .env.test and fill in values.
# Get test-mode keys from https://dashboard.stripe.com (toggle "Test mode" top-right).
# .env.test is gitignored — never commit real keys.

# ── Stripe test-mode secret key ───────────────────────────────────────────────
# Looks like: sk_test_51...
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# ── Webhook signing secret ────────────────────────────────────────────────────
# Generated by `stripe listen` (see docs/stripe-testing.md).
# Looks like: whsec_...
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── Pro plan price IDs (test mode) ───────────────────────────────────────────
# Run `node scripts/stripe-setup.mjs` after filling in STRIPE_SECRET_KEY above.
STRIPE_PRO_MONTHLY_PRICE_ID=price_REPLACE_ME
STRIPE_PRO_ANNUAL_PRICE_ID=price_REPLACE_ME

# ── AI credit pack price IDs (test mode) ─────────────────────────────────────
# Run `node scripts/stripe-setup-credit-packs.mjs` after filling in STRIPE_SECRET_KEY above.
STRIPE_CREDIT_PACK_STARTER_PRICE_ID=price_REPLACE_ME
STRIPE_CREDIT_PACK_STANDARD_PRICE_ID=price_REPLACE_ME
STRIPE_CREDIT_PACK_BULK_PRICE_ID=price_REPLACE_ME
