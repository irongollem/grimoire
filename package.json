{
  "name": "grimoire",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode localdb",
    "dev:local": "vite --mode localdb",
    "dev:hosted": "vite --mode development",
    "dev:portless": "portless grimoire vite --mode localdb",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --config oxlint.json src/ scripts/ supabase/functions/ infra/",
    "lint:fix": "oxlint --config oxlint.json --fix src/ scripts/ supabase/functions/ infra/",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run test && npm run build",
    "verify:db": "npm run db:reset && supabase test db && npm run db:check && npm run db:check:test && npm run db:check:embeds",
    "stripe:check": "tsx --tsconfig tsconfig.node.json scripts/check-stripe-webhook.ts",
    "migrations:check": "node scripts/migration-rebase/cli.mjs --check",
    "migrations:rebase": "node scripts/migration-rebase/cli.mjs --write",
    "hooks:install": "git config core.hooksPath .githooks",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "npm run db:anonymize:check && supabase db reset",
    "db:check": "sh scripts/check-content-integrity.sh",
    "db:check:test": "sh scripts/test-content-integrity.sh",
    "db:check:embeds": "sh scripts/check-embeds.sh",
    "db:pull": "supabase db dump --linked --data-only --schema auth,public -x public.abuse_guard_config -x public.ai_generation_credit_costs -x public.ai_model_pricing -x public.ai_system_prompts -x public.checkout_config -x public.credit_pack_config -x public.provider_config -x public.simulacrum_config -x public.class_choice_rest_resets -x public.class_ritual_policies -x public.class_spellcasting_policies -x public.content_sources -x public.disposable_email_domains -x public.metamagic_options -x public.plans -x public.system_classes -f supabase/seed.sql && npm run db:anonymize",
    "db:anonymize": "tsx --tsconfig tsconfig.node.json scripts/anonymize-seed.ts",
    "db:anonymize:check": "tsx --tsconfig tsconfig.node.json scripts/anonymize-seed.ts --check",
    "stripe:setup": "node --env-file=.env.local scripts/stripe-setup.mjs",
    "import-chapter-npcs": "tsx --env-file=.env.local scripts/import-chapter-npcs.ts",
    "import-faiths": "tsx --env-file=.env.local scripts/import-faiths.ts",
    "migrate-plaintext-to-tiptap": "tsx --env-file=.env.local scripts/migrate-plaintext-to-tiptap.ts",
    "ingest-mini-bases": "tsx --env-file=.env.local scripts/ingest-mini-bases.ts",
    "r2:copy": "tsx --tsconfig tsconfig.node.json --env-file=.env.local scripts/r2-copy.ts",
    "seed-library-spells": "tsx --tsconfig tsconfig.node.json --env-file=.env.local scripts/seed-library-spells.ts",
    "seed-library-monsters": "tsx --tsconfig tsconfig.node.json --env-file=.env.local scripts/seed-library-monsters.ts",
    "seed-library-species": "tsx --tsconfig tsconfig.node.json --env-file=.env.local scripts/seed-library-species.ts",
    "seed-library-items": "tsx --tsconfig tsconfig.node.json --env-file=.env.local scripts/seed-library-items.ts",
    "seed-content-sources": "tsx --tsconfig tsconfig.node.json --env-file=.env.local scripts/seed-content-sources.ts",
    "dev:auth": "tsx --tsconfig tsconfig.node.json scripts/dev-auth.ts",
    "cartographer:pack": "tsx --tsconfig tsconfig.node.json scripts/cartographer-pack.ts"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@lucide/vue": "^1.34.0",
    "@sentry/vue": "^10.71.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/vue-query": "^5.102.8",
    "@tiptap/extension-highlight": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-mention": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/extension-table": "^3.30.5",
    "@tiptap/extension-table-cell": "^3.30.5",
    "@tiptap/extension-table-header": "^3.30.5",
    "@tiptap/extension-table-row": "^3.30.5",
    "@tiptap/extension-task-item": "^3.30.5",
    "@tiptap/extension-task-list": "^3.30.5",
    "@tiptap/extension-text-align": "^3.30.5",
    "@tiptap/extension-typography": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/suggestion": "^3.22.4",
    "@tiptap/vue-3": "^3.30.5",
    "@vercel/speed-insights": "^2.0.0",
    "@vue-flow/core": "^1.48.2",
    "@vuepic/vue-datepicker": "^14.0.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.14",
    "driver.js": "^1.8.0",
    "fflate": "^0.8.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "marked": "^18.0.11",
    "pagedjs": "^0.4.3",
    "pdf-lib": "^1.17.1",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "smartcrop": "^2.0.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.2.4",
    "v-network-graph": "^0.9.22",
    "vue": "^3.5.42",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.5.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.12",
    "jsdom": "^30.0.1",
    "oxlint": "^1.80.0",
    "portless": "^0.15.6",
    "puppeteer-core": "^25.9.0",
    "sharp": "^0.35.4",
    "stripe": "^22.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.12"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.0.0-rc.15"
  },
  "overrides": {
    "@vercel/speed-insights": {
      "vue-router": "$vue-router"
    },
    "@vue/test-utils": {
      "js-beautify": "^2.0.3",
      "nopt": "^9.0.0"
    },
    "pagedjs": {
      "@babel/polyfill": "npm:core-js@^3.50.0"
    }
  },
  "engines": {
    "node": "^24.0.0"
  },
  "allowScripts": {
    "core-js": false,
    "es5-ext": false,
    "vue-demi": false,
    "fsevents": false,
    "esbuild@0.28.2": true,
    "@sentry/cli": false
  }
}
