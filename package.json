{
  "name": "grimoire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:portless": "portless grimoire vite",
    "build": "vue-tsc -b && vite-ssg build",
    "preview": "vite preview",
    "lint": "oxlint --config oxlint.json src/",
    "lint:fix": "oxlint --config oxlint.json --fix src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "stripe:setup": "node --env-file=.env.local scripts/stripe-setup.mjs",
    "import-chapter-npcs": "tsx --env-file=.env.local scripts/import-chapter-npcs.ts",
    "import-faiths": "tsx --env-file=.env.local scripts/import-faiths.ts",
    "migrate-plaintext-to-tiptap": "tsx --env-file=.env.local scripts/migrate-plaintext-to-tiptap.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/vue-query": "^5.72.2",
    "@tiptap/extension-highlight": "^3.22.4",
    "@tiptap/extension-image": "^3.20.1",
    "@tiptap/extension-mention": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.20.1",
    "@tiptap/extension-table": "^3.20.4",
    "@tiptap/extension-table-cell": "^3.20.4",
    "@tiptap/extension-table-header": "^3.20.4",
    "@tiptap/extension-table-row": "^3.20.4",
    "@tiptap/extension-task-item": "^3.22.4",
    "@tiptap/extension-task-list": "^3.22.4",
    "@tiptap/extension-text-align": "^3.22.4",
    "@tiptap/extension-typography": "^3.22.4",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@tiptap/suggestion": "^3.22.4",
    "@tiptap/vue-3": "^3.20.1",
    "@unhead/vue": "^2.1.13",
    "@vuepic/vue-datepicker": "^12.1.0",
    "@vueuse/core": "^12.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "lucide-vue-next": "^0.479.0",
    "marked": "^18.0.1",
    "pinia": "^2.3.1",
    "radix-vue": "^1.9.13",
    "smartcrop": "^2.0.5",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.2.4",
    "v-network-graph": "^0.9.22",
    "vue": "^3.5.13",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^20.9.0",
    "oxlint": "^1.60.0",
    "portless": "^0.10.2",
    "stripe": "^22.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.1",
    "typescript": "~5.7.2",
    "vite": "^8.0.8",
    "vite-ssg": "^28.3.0",
    "vitest": "^4.1.5",
    "vue-tsc": "^2.2.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.0.0-rc.15"
