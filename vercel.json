{
  "git": { "deploymentEnabled": { "main": false } },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ],
  "functions": {
    "api/open-book-card.ts": {
      "includeFiles": "{node_modules/@fontsource/cinzel/files/cinzel-latin-700-normal.woff,node_modules/@fontsource/alegreya/files/alegreya-latin-{400-italic,700-normal}.woff,public/assets/open-book/*.webp,public/brand/logo-dark.webp}"
    }
  },
  "rewrites": [
    { "source": "/w/:path*", "destination": "/api/open-book-page?path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
